<div class="d-flex flex-wrap align-items-center gap-3 mb-3" data-dicom-picker>
    <input type="file" id="dicom-file" name="file" accept=".dcm,application/dicom" required
           class="visually-hidden dicom-file-input" aria-describedby="dicom-file-name" />
    <label for="dicom-file" class="btn btn-outline-primary mb-0">Seleccionar DICOM</label>
    <span id="dicom-file-name" class="text-break" aria-live="polite" data-dicom-file-name>Ningún archivo seleccionado</span>
</div>
