@model DicomLab.Web.ViewModels.ViewerViewModel
@{ ViewData["Title"] = "DICOM Viewer"; }
<h1>DICOM Viewer</h1>
<p>Selecciona un archivo DICOM extraído. Máximo @Model.MaxUploadMb MB.</p>
<form asp-action="Viewer" method="post" enctype="multipart/form-data" class="d-flex gap-2 mb-4">
    <input type="file" name="file" accept=".dcm,application/dicom" required class="form-control" aria-label="Archivo DICOM" />
    <button class="btn btn-primary">Cargar</button>
</form>
@if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
@if (Model.Metadata is not null)
{
    @if (Model.HasPixelData)
    {
        <div class="bg-dark text-center rounded p-3 mb-3">
            <img id="dicom-image" data-src="@Url.Action("Image", new { id = Model.Id, frame = Model.Frame })" alt="Frame DICOM seleccionado" class="img-fluid" style="max-height:65vh" hidden />
            <p id="image-status" class="text-white mb-0" role="status">Renderizando frame…</p>
        </div>
        <div class="d-flex gap-3 align-items-center justify-content-center mb-4">
            @if (Model.Frame > 0) { <a class="btn btn-outline-primary" asp-action="Viewer" asp-route-id="@Model.Id" asp-route-frame="@(Model.Frame - 1)">Anterior</a> }
            <span>Frame @(Model.Frame + 1) / @Model.Frames</span>
            @if (Model.Frame + 1 < Model.Frames) { <a class="btn btn-outline-primary" asp-action="Viewer" asp-route-id="@Model.Id" asp-route-frame="@(Model.Frame + 1)">Siguiente</a> }
        </div>
    }
    else { <div class="alert alert-info">Este DICOM no contiene Pixel Data. Puedes consultar sus tags.</div> }
    <h2 class="h4">Información del DICOM</h2>
    <dl class="row">
        @foreach (var pair in Model.Metadata.MainTags)
        { <dt class="col-sm-3">@pair.Key</dt><dd class="col-sm-9 text-break">@pair.Value</dd> }
        <dt class="col-sm-3">Transfer Syntax</dt><dd class="col-sm-9">@Model.Metadata.TransferSyntax</dd>
        <dt class="col-sm-3">Tags principales</dt><dd class="col-sm-9">@Model.Metadata.TagCount</dd>
    </dl>
    <p class="text-muted">Window Center y Window Width se toman del dataset; si no existen, fo-dicom calcula el renderizado por defecto.</p>
    <h2 class="h4">DicomDataset</h2>
    <p class="text-muted">Valores largos y binarios resumidos. Máximo 10 000 filas y 16 niveles de secuencias.</p>
    <div class="table-responsive"><table class="table table-striped table-sm">
        <thead><tr><th>Tag</th><th>Name</th><th>VR</th><th>Value</th></tr></thead>
        <tbody>@foreach (var tag in Model.Metadata.Tags)
        { <tr><td class="text-nowrap">@tag.Tag</td><td style="padding-left:@(tag.Depth * 12 + 8)px">@tag.Name</td><td>@tag.Vr</td><td class="text-break">@tag.Value</td></tr> }</tbody>
    </table></div>
}
@section Scripts { <script src="~/js/viewer.js" asp-append-version="true"></script> }
